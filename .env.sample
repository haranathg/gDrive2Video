# Copy to .env (never commit .env). Used by deploy_to_rpi.sh and for local testing.

# Google service-account key (JSON) and the Drive folder to mirror
CREDENTIALS_PATH=credentials.json
GDRIVE_FOLDER_ID=YOUR_GOOGLE_DRIVE_FOLDER_ID

# Optional: Google Sheet for sync logging (share it with the service account)
LOG_SPREADSHEET_ID=

# Local testing only (on the Pi these live in /etc/gdrive2video.env, written by setup_pi.sh)
MEDIA_DIR=./media
SLIDESHOW_DELAY=8
# ALLOW_EMPTY_SYNC=true   # let an empty Drive folder clear the screens
# MPV_VO=gpu              # mpv video output; default "gpu,drm" (no desktop)
# MPV_EXTRA_ARGS=--volume=50

# Raspberry Pi to deploy to (set up SSH keys with: ssh-copy-id USER@HOST)
RPI_USER=pi
RPI_HOST=rpi-video.local
RPI_DIR=/home/pi/gdrive2video
