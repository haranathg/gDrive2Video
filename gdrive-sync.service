# Installed by setup_pi.sh, which replaces @USER@ and @PROJECT_DIR@.
[Unit]
Description=gdrive2video: sync media from Google Drive
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=@USER@
Group=@USER@
EnvironmentFile=-/etc/gdrive2video.env
WorkingDirectory=@PROJECT_DIR@
ExecStart=@PROJECT_DIR@/.venv/bin/python @PROJECT_DIR@/gdrive_sync.py
TimeoutStartSec=30min
# Stay out of the player's way.
Nice=10
IOSchedulingClass=idle
