# Installed by setup_pi.sh, which replaces @USER@ and @PROJECT_DIR@.
[Unit]
Description=gdrive2video media player (fullscreen loop on HDMI, no desktop)
After=systemd-user-sessions.service local-fs.target
# Never give up restarting.
StartLimitIntervalSec=0

[Service]
Type=simple
User=@USER@
Group=@USER@
# video/render: draw to the screen via DRM; audio: HDMI sound for videos.
SupplementaryGroups=video render audio
EnvironmentFile=-/etc/gdrive2video.env
WorkingDirectory=@PROJECT_DIR@
# Playlist + mpv socket live on tmpfs (/run/media-player), not the SD card.
RuntimeDirectory=media-player
ExecStart=/usr/bin/python3 @PROJECT_DIR@/media_player.py
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
